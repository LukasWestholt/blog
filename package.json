{
	"name": "2lukas-blog",
	"type": "module",
	"version": "1.1.0",
	"description": "Our great blog project: 2Lukas",
	"author": "danielcgilibert",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/lukaswestholt/blog"
	},
	"keywords": [
		"astro",
		"astrojs",
		"astro-template",
		"astro-blog",
		"astro-b"
	],
	"bugs": {
		"url": "https://github.com/lukaswestholt/blog/issues"
	},
	"scripts": {
		"start": "astro dev",
		"build": "astro build",
		"build:preview": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "astro sync && astro-check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"pre-commit": "lint-staged",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.1",
		"astro": "4.0.8",
		"astro-font": "^0.0.72",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "2.0.3",
		"@astrojs/sitemap": "3.0.4",
		"@astrojs/tailwind": "5.1.0",
		"@pagefind/default-ui": "^1.0.4",
		"@tailwindcss/typography": "0.5.20",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "3.2.7",
		"clsx": "2.1.1",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^10.16.4",
		"pagefind": "^1.0.3",
		"prettier": "^3.9.6",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^0.14.1",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.6",
		"tailwind-merge": "2.0.0",
		"tailwindcss": "3.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^3.2.7"
	},
	"lint-staged": {
		"*.{astro,js,jsx,mjs,cjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{md,mdx,json,yml,yaml,css}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
