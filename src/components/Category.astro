---
import { cn, url, stripBase } from '@/utils'
import { getCategoryTranslation } from '@/data/categories'

const { name = 'View All', activeCategory } = Astro.props
const currentPath = stripBase(Astro.url.pathname)

const isEnglish = currentPath.startsWith('/en/') || currentPath === '/en'

const displayName = getCategoryTranslation(name, isEnglish ? 'en' : 'de')

// Kategorie-Slug erstellen (aus "Football Manager" wird "football-manager")
const categorySlug = name.toLowerCase().replace(/\s+/g, '-')

const isActive =
	activeCategory?.toLocaleLowerCase() === categorySlug ||
	(currentPath === '/' && name === 'View All') ||
	(currentPath === '/en/' && name === 'View All')

// Die korrekte URL aufbauen (mit oder ohne /en)
const href = url(
	name === 'View All'
		? isEnglish
			? '/en/'
			: '/'
		: isEnglish
			? `/en/category/${categorySlug}/1`
			: `/category/${categorySlug}/1`
)
---

<a
	href={href}
	class={cn(
		`text-neutral-600 dark:text-neutral-300 pb-2.5 first-letter:uppercase font-medium hover:text-neutral-800 dark:hover:text-secondary-dark border-b-2 border-transparent hover:border-secondary dark:hover:border-secondary-dark transition-colors duration-150 ease-linear`,
		isActive &&
			`border-secondary dark:border-secondary-dark text-secondary z-10 dark:text-secondary-dark`
	)}
>
	{displayName}
</a>
